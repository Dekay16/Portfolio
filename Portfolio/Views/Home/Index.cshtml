@using Portfolio.Business.ViewModels
@model List<ProjectsViewModel>
@{
    ViewData["Title"] = "Home Page";
}

<style>
    /* Local view styles for a clean, professional card grid */
    .hero {
        background: linear-gradient(180deg, rgba(52,58,64,0.06), rgba(255,255,255,0));
        border-radius: 12px;
        padding: 2.5rem;
        margin-bottom: 1.5rem;
    }

    .project-card {
        border: 0;
        border-radius: 10px;
        overflow: hidden;
        transition: transform .18s ease, box-shadow .18s ease;
        box-shadow: 0 6px 18px rgba(18, 18, 20, 0.06);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .project-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 40px rgba(18, 18, 20, 0.12);
    }

    .project-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        background: #f5f5f7;
    }

    .card-body .description {
        max-height: 4.5rem;
        overflow: hidden;
        color: #495057;
    }

    .tech-badges .badge {
        margin-right: 0.35rem;
        margin-bottom: 0.35rem;
    }

    .admin-actions {
        opacity: 0;
        transition: opacity .15s ease;
    }

    .card:hover .admin-actions {
        opacity: 1;
    }

    .projects-toolbar {
        gap: .5rem;
    }

    @@media (max-width: 767px) {
        .project-img {
            height: 140px;
        }
    }
</style>

<div class="container py-4">
    <section class="hero">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 mb-2">Hi — I’m Dekan Peterson</h1>
                <p class="lead mb-3">Software Engineer building clean, secure, and efficient .NET applications. I focus on maintainable architecture, practical automation, and delivering business value.</p>
                <div class="d-flex projects-toolbar">
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-primary me-2">Contact / Resume</a>
                    <button type="button" onclick="openAddEditModal(0)" class="btn btn-outline-success">+ Add Project</button>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="d-inline-block text-center">
                    <div class="fs-1 text-secondary mb-2"><i class="fa-solid fa-user-circle"></i></div>
                    <div class="text-muted">Full‑stack .NET • Power Applications • CI/CD</div>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-5">
        <div class="mb-4">
            <h4 class="mb-3">Professional Experience (Confidential)</h4>
            <small class="text-muted d-block mb-3">Proprietary projects built during my career — high-level summaries provided under company policy.</small>
        </div>

        <div class="row g-4 mb-4">
            <!-- Intranet Site Management -->
            <div class="col-sm-6 col-lg-4 d-flex">
                <div class="card project-card w-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-2">Intranet Site Management & Reminders</h5>
                        <p class="description card-text mb-2">Built a centralized platform for communications teams to track and manage multiple organization intranet sites. Implemented automated reminder system with user-configurable notification preferences, admin dashboard, and SQL-based email scheduling. Improved content freshness and reduced manual coordination overhead.</p>
                        <div class="tech-badges mb-3">
                            <span class="badge bg-light text-dark border">C# / ASP.NET Core</span>
                            <span class="badge bg-light text-dark border">SQL Server</span>
                            <span class="badge bg-light text-dark border">Email Automation</span>
                            <span class="badge bg-light text-dark border">Admin Dashboard</span>
                        </div>
                        <small class="text-muted mt-auto"><i class="fa-lock me-1"></i> Code proprietary — not publicly available.</small>
                    </div>
                </div>
            </div>

            <!-- Physical Security Tracking & Audit -->
            <div class="col-sm-6 col-lg-4 d-flex">
                <div class="card project-card w-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-2">Physical Security Audit & Logging (ColdFusion → .NET)</h5>
                        <p class="description card-text mb-2">Rewrote legacy ColdFusion application to modern .NET platform for physical security team. Tracks, logs, and audits security incidents with full audit trail. Integrated customer notification system with form generation and email delivery. Enhanced data integrity, compliance reporting, and operational transparency.</p>
                        <div class="tech-badges mb-3">
                            <span class="badge bg-light text-dark border">C# / ASP.NET Core</span>
                            <span class="badge bg-light text-dark border">SQL Server</span>
                            <span class="badge bg-light text-dark border">Audit Logging</span>
                            <span class="badge bg-light text-dark border">Email Integration</span>
                        </div>
                        <small class="text-muted mt-auto"><i class="fa-lock me-1"></i> Code proprietary — not publicly available.</small>
                    </div>
                </div>
            </div>

            <!-- Engineering & QA Reports -->
            <div class="col-sm-6 col-lg-4 d-flex">
                <div class="card project-card w-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-2">Engineering & QA Reporting (ColdFusion → .NET)</h5>
                        <p class="description card-text mb-2">Migrated two ColdFusion reporting applications serving engineering and QA teams. Built dynamic query interfaces, complex data aggregation, and customizable report generation. Improved report generation performance and enabled self-service analytics for cross-functional teams.</p>
                        <div class="tech-badges mb-3">
                            <span class="badge bg-light text-dark border">C# / ASP.NET Core</span>
                            <span class="badge bg-light text-dark border">Oracle SQL Developer</span>
                            <span class="badge bg-light text-dark border">Reporting</span>
                            <span class="badge bg-light text-dark border">Data Analytics</span>
                        </div>
                        <small class="text-muted mt-auto"><i class="fa-lock me-1"></i> Code proprietary — not publicly available.</small>
                    </div>
                </div>
            </div>

            <!-- Time Off & Employee Dashboard -->
            <div class="col-sm-6 col-lg-4 d-flex">
                <div class="card project-card w-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-2">Time Off Request & Employee Dashboard (ColdFusion → .NET)</h5>
                        <p class="description card-text mb-2">Rewrote internal time-off request system with modern .NET backend. Features include request workflow, multi-recipient notifications, employee information dashboard, and approval management. Streamlined HR processes and improved visibility across the organization.</p>
                        <div class="tech-badges mb-3">
                            <span class="badge bg-light text-dark border">C# / ASP.NET Core</span>
                            <span class="badge bg-light text-dark border">Oracle SQL Developer</span>
                            <span class="badge bg-light text-dark border">Notifications</span>
                            <span class="badge bg-light text-dark border">Dashboard UI</span>
                        </div>
                        <small class="text-muted mt-auto"><i class="fa-lock me-1"></i> Code proprietary — not publicly available.</small>
                    </div>
                </div>
            </div>

            <!-- HoloLens & Mixed Reality -->
            <div class="col-sm-6 col-lg-4 d-flex">
                <div class="card project-card w-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-2">Mixed Reality Applications (HoloLens / Unity)</h5>
                        <p class="description card-text mb-2">Developed multiple Unity-based applications for Microsoft HoloLens, exploring spatial computing and mixed reality experiences. Projects focused on AR visualization, spatial interaction, and enterprise use cases.</p>
                        <div class="tech-badges mb-3">
                            <span class="badge bg-light text-dark border">Unity</span>
                            <span class="badge bg-light text-dark border">C#</span>
                            <span class="badge bg-light text-dark border">HoloLens</span>
                            <span class="badge bg-light text-dark border">Mixed Reality</span>
                        </div>
                        <small class="text-muted mt-auto"><i class="fa-lock me-1"></i> Code proprietary — not publicly available.</small>
                    </div>
                </div>
            </div>

            <!-- Power Apps & Power BI -->
            <div class="col-sm-6 col-lg-4 d-flex">
                <div class="card project-card w-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-2">Power Apps & Power BI Reports</h5>
                        <p class="description card-text mb-2">Built multiple low-code / no-code solutions using Microsoft Power Apps and Power BI to empower business teams with self-service analytics and workflow automation. Projects increased operational efficiency and enabled data-driven decision making across departments.</p>
                        <div class="tech-badges mb-3">
                            <span class="badge bg-light text-dark border">Power Apps</span>
                            <span class="badge bg-light text-dark border">Power BI</span>
                            <span class="badge bg-light text-dark border">Business Intelligence</span>
                            <span class="badge bg-light text-dark border">Low-Code</span>
                        </div>
                        <small class="text-muted mt-auto"><i class="fa-lock me-1"></i> Code proprietary — not publicly available.</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Personal Projects</h4>
        <small class="text-muted">@Model?.Count projects</small>
    </div>

    <div class="row g-4">
        @if (Model == null || Model.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-info mb-0">
                    No projects found. Use the <strong>+ Add Project</strong> button to add your first project.
                </div>
            </div>
        }
        else
        {
            for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <div class="col-sm-6 col-lg-4 d-flex">
                    <div class="card project-card w-100">
                        <img src="@item.ImageDataUrl" alt="Screenshot for @item.Title" class="project-img card-img-top" />
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@item.Title</h5>
                                <div class="admin-actions">
                                    <a title="Edit" onclick="openAddEditModal(@item.ID)" class="text-dark me-2" role="button" aria-label="Edit @item.Title">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a title="Delete" onclick="deleteProject(@item.ID)" class="text-danger" role="button" aria-label="Delete @item.Title">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </div>

                            <p class="description card-text mb-2">@item.Description</p>

                            <div class="tech-badges mb-3">
                                @{
                                    var techs = (item.Technologies ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                    foreach (var tech in techs)
                                    {
                                        <span class="badge bg-light text-dark border">@tech</span>
                                    }
                                }
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                <a href="@item.GitHubLink" target="_blank" class="btn btn-outline-dark btn-sm" rel="noopener noreferrer">
                                    <i class="fa-brands fa-github me-1"></i> Source
                                </a>
                                @* @if (!string.IsNullOrWhiteSpace(item.GitHubLink))
                                {
                                    <a href="@item.GitHubLink" target="_blank" class="btn btn-primary btn-sm" rel="noopener noreferrer">Live Demo</a>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" disabled>Live Demo</button>
                                } *@
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Add / Edit Modal (content loaded dynamically) -->
<div class="modal fade" id="addEditProjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="projectContent">
            <div class="modal-header">
                <h5 class="modal-title">Add / Edit Project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="addEditModalBody">
                <!-- Server will inject partial view via AJAX -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary" form="addeditprojectform">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/home/index.js"></script>
    <script>
        // Enable Bootstrap tooltips (used for admin icons)
        $(function () {
            var tipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
        });
    </script>
}