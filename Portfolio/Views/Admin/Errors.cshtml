@{
    ViewData["Title"] = "Error Logs";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Error Logs</h2>
        <div>
            <input type="date" id="startDate" class="form-control d-inline-block" style="width:160px" />
            <input type="date" id="endDate" class="form-control d-inline-block ms-2" style="width:160px" />
            <button id="btnFilterErrors" class="btn btn-sm btn-primary ms-2">Filter</button>
        </div>
    </div>

    <table id="errorsTable" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Time</th>
                <th>Level</th>
                <th>Message</th>
                <th>Path</th>
                <th>User</th>
                <th>Type</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(function () {
            var table = $('#errorsTable').DataTable({
                ajax: {
                    url: '/Admin/Errors/Logs',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'timeStamp', render: function (d) { return new Date(d).toLocaleString(); } },
                    { data: 'level' },
                    { data: 'message' },
                    { data: 'path' },
                    { data: 'userId' },
                    { data: 'type' }
                ],
                pageLength: 25
            });

            $('#btnFilterErrors').on('click', function () {
                var start = $('#startDate').val();
                var end = $('#endDate').val();
                // reload with params
                table.ajax.url('/Admin/Errors/Logs?startDate=' + encodeURIComponent(start) + '&endDate=' + encodeURIComponent(end)).load();
            });
        });
    </script>
}